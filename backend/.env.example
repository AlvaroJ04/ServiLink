# Copia este archivo a ".env" y ajusta los valores con tu PostgreSQL local.
#
# IMPORTANTE: el nombre de la base de datos es "plataforma_servicios", no
# "servilink" -- así la creó el compañero encargado de la base de datos, y
# ese es el nombre real que hay que usar para que el backend hable con la
# base de datos verdadera del proyecto (ver Diccionario_de_Datos.docx).
#
# Reemplaza usuario, contraseña, host y puerto según cómo tengas configurado
# tu PostgreSQL (o el del compañero, si se conecta a una instancia
# compartida en vez de una copia local -- confirma esto con él).
DATABASE_URL=postgresql+psycopg://usuario:contrasena@localhost:5432/plataforma_servicios

# Genera uno propio con: openssl rand -hex 32
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_SECRETA_LARGA_Y_ALEATORIA

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origen permitido para el frontend (React + Vite) en desarrollo local
FRONTEND_ORIGIN=http://localhost:5173

# --- Almacenamiento de documentos de verificación (HU-04) ---
# Con Azure: pega aquí la "Connection string" de tu cuenta de Azure Storage.
# El contenedor se crea PRIVADO (sin acceso público).
# Si lo dejas vacío (desarrollo local), los archivos se guardan en la carpeta
# "uploads_privados" del backend, que NO se publica en internet.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER=documentos-verificacion
MAX_UPLOAD_MB=5
